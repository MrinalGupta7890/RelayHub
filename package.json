{
  "name": "relayhub",
  "private": true,
  "version": "0.1.0",
  "description": "RelayHub - Webhook Orchestrator Platform (monorepo root)",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.7.0",
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "dev:api": "pnpm --filter @relayhub/api run dev",
    "dev:worker": "pnpm --filter @relayhub/worker run dev",
    "dev:web": "pnpm --filter @relayhub/web run dev",
    "db:generate": "pnpm --filter @relayhub/database run generate",
    "db:migrate:dev": "pnpm --filter @relayhub/database run migrate:dev",
    "db:migrate:deploy": "pnpm --filter @relayhub/database run migrate:deploy",
    "db:seed": "pnpm --filter @relayhub/database run seed",
    "db:studio": "pnpm --filter @relayhub/database run studio"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}
